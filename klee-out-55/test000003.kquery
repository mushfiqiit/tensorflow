array dims[24] : w32 -> w8 = symbolic
array dtype[4] : w32 -> w8 = symbolic
array len[8] : w32 -> w8 = symbolic
array offset[4] : w32 -> w8 = symbolic
(query [(Eq 1
             (ReadLSB w32 0 dtype))
         (Ult N0:(ReadLSB w32 0 offset)
              32)
         (Eq false
             (Ult 0
                  N1:(ReadLSB w64 0 len)))
         (Eq false
             (Eq 0
                 (SRem w64 (Add w64 139257665388544 (ZExt w64 N0))
                           64)))
         (Eq false
             (Sle N2:(ReadLSB w64 0 dims)
                  0))
         (Eq false
             (Sle N3:(ReadLSB w64 8 dims)
                  0))
         (Ult N1
              (Mul w64 4 (Mul w64 N2 N3)))]
        false)
