array dims[24] : w32 -> w8 = symbolic
array dtype[4] : w32 -> w8 = symbolic
array len[8] : w32 -> w8 = symbolic
array offset[4] : w32 -> w8 = symbolic
(query [(Sle 18446744073709551516
              N0:(ReadLSB w64 0 dims))
         (Sle N0 100)
         (Sle 18446744073709551516
              N1:(ReadLSB w64 8 dims))
         (Sle N1 100)
         (Eq 1
             (ReadLSB w32 0 dtype))
         (Ule N2:(ReadLSB w64 0 len)
              128)
         (Ule 0 N2)
         (Eq 0
             (ReadLSB w32 0 offset))]
        false)
